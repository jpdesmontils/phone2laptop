# Active la réécriture d’URL
RewriteEngine On

# Bloque l'accès direct au dossier /views/
RewriteRule ^views/ - [R=403,L]

# Autorise explicitement l'accès au manifest.json
<Files "manifest.json">
  Require all granted
  Header set Content-Type "application/manifest+json"
</Files>

# (Optionnel) — Pour t'assurer que les fichiers JSON sont servis avec le bon type MIME
AddType application/manifest+json .webmanifest .json

# (Optionnel) — Améliore la sécurité générale
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>
