# Active la réécriture d’URL
RewriteEngine On

# Bloque l'accès direct au dossier /views/
RewriteRule ^views/ - [R=403,L]

# Les ressources publiques doivent rester accessibles même si l'hébergeur
# applique une règle d'accès restrictive dans un dossier parent.
<FilesMatch "\.(?:css|ico|js|json|png|svg|webmanifest)$">
  Require all granted
</FilesMatch>

# (Optionnel) — Pour t'assurer que les fichiers JSON sont servis avec le bon type MIME
AddType application/manifest+json .webmanifest .json

# (Optionnel) — Améliore la sécurité générale
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer-when-downgrade"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
</IfModule>
