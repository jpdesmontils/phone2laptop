<!doctype html>
<html lang="{{locale_code}}">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{meta.title}}</title><meta name="description" content="{{meta.description}}"><meta name="theme-color" content="#007BFF">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="icon" href="{{base_url}}/favicon.ico" sizes="any"><link rel="manifest" href="{{base_url}}/manifest.json">
  <style>body{scroll-behavior:smooth}.hero{background:#f8f9fa}.upload-counter{background:#fff;border-top:1px solid #e9ecef;box-shadow:0 .25rem .75rem rgba(0,0,0,.04)}.upload-counter-value{font-variant-numeric:tabular-nums}#shared-text{height:240px;resize:vertical}.step-icon{font-size:2.5rem}.language-switcher{width:auto}</style>
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm"><div class="container">
<a class="navbar-brand fw-bold" href="{{base_url}}/"><img src="{{base_url}}/assets/images/icon.svg" width="48" alt=""> phone2laptop</a>
<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Menu"><span class="navbar-toggler-icon"></span></button>
<div class="collapse navbar-collapse justify-content-end" id="navbarNav"><ul class="navbar-nav align-items-lg-center gap-lg-2">
<li class="nav-item"><a class="nav-link" href="#why">{{nav.why}}</a></li><li class="nav-item"><a class="nav-link" href="#donate">{{nav.about}}</a></li><li class="nav-item"><a class="nav-link" href="https://donate.stripe.com/4gM5kE2z69M21qFbDAew807">{{nav.contribute}}</a></li>
<li class="nav-item"><label class="visually-hidden" for="language-select">{{language.label}}</label><select id="language-select" class="form-select form-select-sm language-switcher" aria-label="{{language.label}}" data-fr-url="{{fr_url}}" data-en-url="{{en_url}}"><option value="fr"{{#is_fr}} selected{{/is_fr}}>{{language.fr}}</option><option value="en"{{#is_en}} selected{{/is_en}}>{{language.en}}</option></select></li>
{{#landing}}<li><a href="#transfer" class="btn btn-primary shadow"><i class="bi bi-qr-code-scan me-2"></i>{{nav.start}}</a></li>{{/landing}}
</ul></div></div></nav>
{{#landing}}<header class="hero text-center pt-4"><h1 class="display-4 fw-bold">{{{hero.title}}}<span class="text-primary"><br>{{hero.accent}}</span></h1><div class="container py-5">
<p class="lead mb-4 mt-3">{{{hero.intro}}}</p><ul class="list-unstyled text-start d-inline-block"><li>{{{hero.benefit1}}}</li><li>{{{hero.benefit2}}}</li><li>{{{hero.benefit3}}}</li><li>{{{hero.benefit4}}}</li></ul><div><a href="{{start_url}}#transfer" class="btn btn-primary btn-lg px-5 py-3 shadow"><i class="bi bi-qr-code-scan me-2"></i>{{hero.start}}</a></div><p class="small text-muted mt-3">{{hero.reassurance}}</p></div>
<div class="upload-counter py-3" aria-label="{{hero.counter_aria}}"><strong class="upload-counter-value fs-5">{{{upload_count}}}</strong> <span class="text-muted">{{hero.counter}}</span></div></header>
<section class="py-5"><div class="container"><h2 class="text-center mb-4">{{hero.how}}</h2><div class="row g-4 text-center"><div class="col-md-4"><div class="step-icon">1</div><h5>{{hero.step1_title}}</h5><p>{{hero.step1_text}}</p></div><div class="col-md-4"><div class="step-icon">2</div><h5>{{hero.step2_title}}</h5><p>{{{hero.step2_text}}}</p></div><div class="col-md-4"><div class="step-icon">3</div><h5>{{hero.step3_title}}</h5><p>{{{hero.step3_text}}}</p></div></div></div></section>
<section id="why"><div class="container"><div class="text-center mb-5"><h2>{{why.title}}</h2><p class="lead text-muted">{{{why.lead}}}</p></div><div class="row"><div class="col-md-6 p-4"><h4 class="text-danger">{{why.problem}}</h4><ul class="list-unstyled"><li class="mb-3">{{{why.p1}}}</li><li class="mb-3">{{{why.p2}}}</li><li class="mb-3">{{{why.p3}}}</li><li class="mb-3">{{{why.p4}}}</li></ul><p>{{why.result}}</p></div><div class="col-md-6 p-4 border-start border-primary border-3"><h4 class="text-success">{{why.solution}}</h4><ul class="list-unstyled"><li class="mb-3">{{{why.s1}}}</li><li class="mb-3">{{{why.s2}}}</li><li class="mb-3">{{{why.s3}}}</li><li class="mb-3">{{{why.s4}}}</li><li class="mb-3">{{{why.s5}}}</li><li class="mb-3">{{{why.s6}}}</li></ul></div></div></div></section>
{{/landing}}
<section id="transfer" class="py-5"><div class="container text-center"><h1 class="fw-bold mb-3 text-primary">{{exchange.title}}</h1><div id="session-qr" class="d-inline-block p-2 bg-white rounded-3 shadow-sm" role="img" aria-label="{{exchange.qr_aria}}"></div>{{#landing}}<p class="small text-muted mt-2">{{exchange.sync}}</p>{{/landing}}
<div class="alert alert-primary" role="status"><i class="bi bi-shield-lock-fill"></i> {{exchange.security}} <span id="expiry-label">{{exchange.expiry_pending}}</span><strong id="expiry-countdown"></strong>.</div>
<div class="row g-4 text-start" id="share"><div class="col-md-6"><div class="border rounded-3 p-4 text-center h-100"><h5>{{exchange.files}}</h5><form id="upload-form"><label for="file-input" class="btn btn-outline-primary mb-2">{{exchange.choose}}</label><input id="file-input" class="d-none" type="file" multiple><p class="small text-muted">{{{exchange.drop}}}</p><div id="upload-progress" style="display:none"><div class="progress"><div id="progress-bar" class="progress-bar" style="width:0%"></div></div><small>{{exchange.uploading}}</small></div></form><ul id="file-list" class="list-group mt-3"></ul></div></div>
<div class="col-md-6"><div class="border rounded-3 p-4 h-100"><div class="d-flex justify-content-between"><h5>{{exchange.notes}}</h5><button id="btn-copy" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard"></i> {{exchange.copy}}</button></div><textarea id="shared-text" class="form-control" placeholder="{{exchange.placeholder}}"></textarea></div></div></div><button id="btn-delete" class="btn btn-outline-danger btn-sm mt-4"><i class="bi bi-trash"></i> {{exchange.delete}}</button></div></section>
{{#landing}}<section class="py-5 bg-light"><div class="container"><h2 class="text-center mb-4">{{reasons.title}}</h2><div class="row g-4"><div class="col-md-6"><h5>{{reasons.r1}}</h5><p>{{reasons.r1t}}</p></div><div class="col-md-6"><h5>{{reasons.r2}}</h5><p>{{reasons.r2t}}</p></div><div class="col-md-6"><h5>{{reasons.r3}}</h5><p>{{{reasons.r3t}}}</p></div><div class="col-md-6"><h5>{{reasons.r4}}</h5><p>{{reasons.r4t}}</p></div></div></div></section>
<section id="donate" class="py-5"><div class="container"><div class="mx-auto col-lg-8 bg-white p-4 rounded-3 shadow-sm border"><h5 class="text-center">{{donate.why}}</h5><p class="text-muted">{{{donate.about}}}</p><p class="text-muted">{{donate.mission}}</p></div></div></section>{{/landing}}
<section class="pb-5"><div class="container text-center"><h5>{{donate.love}}</h5><p>{{donate.support}}</p><a href="https://donate.stripe.com/4gM5kE2z69M21qFbDAew807" target="_blank" rel="noopener" class="btn btn-success btn-lg"><i class="bi bi-heart"></i> {{donate.button}}</a><p class="small text-muted mt-2">{{donate.thanks}}</p></div></section>
<footer class="bg-dark text-white pt-5 pb-4"><div class="container"><div class="row"><div class="col-md-6"><h5>{{footer.about_title}}</h5><p class="opacity-75">{{footer.about}}</p></div><div class="col-md-3"><h5>{{footer.links}}</h5><ul class="list-unstyled opacity-75"><li><a href="#why" class="text-white">{{footer.why}}</a></li><li><a href="#transfer" class="text-white">{{footer.features}}</a></li><li><a href="https://donate.stripe.com/4gM5kE2z69M21qFbDAew807" class="text-white">{{footer.contribute}}</a></li></ul></div><div class="col-md-3"><h5>phone2laptop</h5><p>{{footer.tagline}}<br>© {{year}} Solenis Studio</p></div></div><hr><div class="text-center opacity-50 small">{{footer.privacy}}</div></div></footer>
<script>window.P2L={{{p2l_config}}};document.getElementById('language-select').addEventListener('change',function(){location.href=this.dataset[this.value+'Url']+location.hash;});</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script><script src="{{base_url}}/js/sync.js"></script>
</body></html>
