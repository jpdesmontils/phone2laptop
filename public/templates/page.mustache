<!doctype html>
<html lang="{{locale_code}}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{meta.title}}</title>
<meta name="description" content="{{meta.description}}">
<meta name="theme-color" content="#007BFF">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Phone2Laptop">
<meta property="og:title" content="{{meta.title}}">
<meta property="og:description" content="{{meta.description}}">
<meta property="og:url" content="{{base_url}}/">
<meta property="og:locale" content="{{locale_code}}">
<meta property="og:image" content="{{base_url}}/assets/icones/icon-512x512.png">
<meta property="og:image:width" content="512">
<meta property="og:image:height" content="512">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{meta.title}}">
<meta name="twitter:description" content="{{meta.description}}">
<meta name="twitter:image" content="{{base_url}}/assets/icones/icon-512x512.png">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
<link rel="icon" href="{{base_url}}/favicon.ico" sizes="any">
<link rel="manifest" href="{{base_url}}/manifest.json">
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"WebApplication","name":"Phone2Laptop","description":"{{{meta.description}}}","url":"{{base_url}}/","applicationCategory":"UtilitiesApplication","operatingSystem":"Any (web browser)","offers":{"@type":"Offer","price":"0","priceCurrency":"EUR"},"creator":{"@type":"Organization","name":"Solenis Studio","url":"https://solenis-studio.fr"}}
</script>
<style>
  :root{
    --p2l-ink:#0B1220;
    --p2l-ink-soft:#5B6472;
    --p2l-line:#E5E9F0;
    --p2l-tint:#F6F8FC;
    --bs-primary:#007BFF;
    --bs-primary-rgb:0,123,255;
    --bs-link-color:#007BFF;
    --bs-link-hover-color:#0056B3;
    --bs-body-color:var(--p2l-ink);
    --bs-body-font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",system-ui,sans-serif;
    --bs-border-color:var(--p2l-line);
    --bs-border-radius:.6rem;
  }
  body{scroll-behavior:smooth}
  h1,h2,h3{letter-spacing:-.01em}
  .navbar{border-bottom:1px solid var(--p2l-line)}
  .overline{font-size:.78rem;letter-spacing:.04em;color:#0056B3;font-weight:600}
  .link-quiet{color:var(--p2l-ink-soft);text-decoration:underline;text-underline-offset:3px}
  .link-quiet:hover{color:var(--p2l-ink)}

  .hero{padding-top:3rem}
  .hero-title{font-size:clamp(1.75rem,4vw,2.4rem);font-weight:700;max-width:22ch;margin:0 auto .8rem}
  .hero-sub{color:var(--p2l-ink-soft);max-width:52ch;margin:0 auto;font-size:1.05rem}

  .transfer-card{max-width:560px;border:1px solid var(--p2l-line);border-radius:1rem;padding:2rem 1.5rem}
  .qr-box{width:180px;height:180px}
  .transfer-instruction{color:var(--p2l-ink-soft);font-size:.92rem;margin-top:1rem}
  .reassurance{color:var(--p2l-ink-soft);font-size:.82rem}
  .reassurance strong{color:var(--p2l-ink);font-weight:600}
  .counter-value{font-variant-numeric:tabular-nums;font-size:1.1rem}
  .session-status{background:var(--p2l-tint);border:1px solid var(--p2l-line);color:var(--p2l-ink-soft);font-size:.85rem;border-radius:.6rem}
  .panel{border:1px solid var(--p2l-line);border-radius:.85rem;padding:1.4rem}
  #shared-text{height:200px;resize:vertical}
  .file-preview{width:3.5rem;height:3.5rem;border:1px solid var(--p2l-line);border-radius:.45rem;background:var(--p2l-tint);overflow:hidden;display:flex;align-items:center;justify-content:center;flex:0 0 auto;color:var(--p2l-ink-soft);font-size:1.5rem;padding:0}
  .file-preview:hover{border-color:var(--bs-primary);color:var(--bs-primary)}
  .file-preview img{width:100%;height:100%;object-fit:cover}
  .document-preview{width:100%;height:min(72vh,760px);border:0;display:block}
  .document-preview-message{min-height:12rem}

  .section-block{padding:3.5rem 0;border-bottom:1px solid var(--p2l-line)}
  .section-block:last-of-type{border-bottom:none}
  .section-tint{background:var(--p2l-tint)}
  .section-title{font-size:1.35rem;font-weight:700;max-width:34ch;margin-left:auto;margin-right:auto}
  .section-lead{color:var(--p2l-ink-soft);max-width:60ch}

  .step .step-num{display:inline-block;font-weight:700;color:#0056B3;font-size:.85rem;margin-bottom:.3rem}

  .use-item strong{display:block;margin-bottom:.2rem}
  .use-item span{color:var(--p2l-ink-soft);font-size:.9rem}

  .instruction-panel{max-width:520px;background:var(--p2l-tint);border:1px solid var(--p2l-line);border-radius:.75rem;padding:1.2rem 1.4rem}

  .compare-table{font-size:.88rem}
  .compare-table th, .compare-table td{border-color:var(--p2l-line) !important}
  .compare-table thead th{color:var(--p2l-ink-soft);font-weight:600;font-size:.75rem;text-transform:uppercase;letter-spacing:.02em;background:transparent}
  .compare-table .col-p2l{color:#0056B3}

  .sec-list > div{padding-bottom:1.1rem;margin-bottom:1.1rem;border-bottom:1px solid var(--p2l-line)}
  .sec-list > div:last-child{border-bottom:none;margin-bottom:0;padding-bottom:0}

  .support-row{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:1.2rem;background:var(--p2l-tint);border:1px solid var(--p2l-line);border-radius:1rem;padding:1.6rem 1.8rem}

  .site-footer{padding:2.5rem 0}
  .site-footer a{color:var(--p2l-ink-soft);text-decoration:none}
  .site-footer a:hover{color:var(--p2l-ink)}

  a:focus-visible, button:focus-visible, select:focus-visible, input:focus-visible, textarea:focus-visible{
    outline:2px solid #007BFF;outline-offset:2px;
  }
</style>
</head>
<body>

<nav class="navbar navbar-expand-lg bg-white">
  <div class="container">
    <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="{{base_url}}/">
      <img src="{{base_url}}/assets/images/icon.svg" width="26" height="26" alt=""> phone2laptop
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-label="Menu">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
      <ul class="navbar-nav align-items-lg-center gap-lg-4">
        {{#landing}}
        <li class="nav-item"><a class="nav-link" href="#how">{{nav.how}}</a></li>
        <li class="nav-item"><a class="nav-link" href="#security">{{nav.security}}</a></li>
        {{/landing}}
        <li class="nav-item"><a class="nav-link" href="https://github.com/jpdesmontils/phone2laptop" target="_blank" rel="noopener">{{nav.source}}</a></li>
        <li class="nav-item"><a class="nav-link small text-body-secondary" href="https://solenis-studio.fr?utm_source=phone2laptop&amp;utm_medium=product&amp;utm_campaign=header" target="_blank" rel="noopener">{{nav.solenis}}</a></li>
        <li class="nav-item">
          <label class="visually-hidden" for="language-select">{{language.label}}</label>
          <select id="language-select" class="form-select form-select-sm" style="width:auto" aria-label="{{language.label}}" data-fr-url="{{fr_url}}" data-en-url="{{en_url}}">
            <option value="fr"{{#is_fr}} selected{{/is_fr}}>{{language.fr}}</option>
            <option value="en"{{#is_en}} selected{{/is_en}}>{{language.en}}</option>
          </select>
        </li>
      </ul>
    </div>
  </div>
</nav>

<main>

{{#landing}}
<header class="hero text-center">
  <div class="container">
    <span class="overline d-block mb-2">{{hero.overline}}</span>
    <h1 class="hero-title">{{hero.title}}</h1>
    <p class="hero-sub mb-0">{{hero.subtitle}}</p>
  </div>
</header>
{{/landing}}

<section id="transfer" class="py-5">
  <div class="container">
    <div class="transfer-card mx-auto text-center">
      <div id="session-qr" class="qr-box mx-auto d-flex align-items-center justify-content-center" role="img" aria-label="{{transfer.qrAria}}"></div>

      {{#landing}}
      <p class="transfer-instruction mb-0">{{transfer.instruction}}</p>
      <div class="mt-3">
        <a href="{{start_url}}#transfer" class="btn btn-primary btn-lg px-4">{{hero.cta}}</a>
      </div>
      <p class="reassurance mt-3 mb-1">{{{hero.reassurance1}}}</p>
      <p class="reassurance mb-0">{{hero.reassurance2}}</p>
      <div class="mt-3 pt-3 border-top">
        <strong class="counter-value">{{{upload_count}}}</strong> <span class="text-body-secondary small">{{hero.counter}}</span>
      </div>
      {{/landing}}
      {{^landing}}
      <h2 class="h5 mt-3">{{transfer.qrAria}}</h2>
      {{/landing}}

      <div class="alert session-status mt-4 mb-0" role="status">
        <i class="bi bi-shield-lock" aria-hidden="true"></i>
        {{transfer.security}} <span id="expiry-label">{{transfer.expiryPending}}</span><strong id="expiry-countdown"></strong>.
      </div>
    </div>

    <div class="row g-4 text-start mt-2 mx-auto" id="share" style="max-width:900px">
      <div class="col-md-6">
        <div class="panel h-100 text-center">
          <h3 class="h6">{{transfer.files}}</h3>
          <form id="upload-form">
            <label for="file-input" class="btn btn-outline-primary mb-2">{{transfer.choose}}</label>
            <input id="file-input" class="d-none" type="file" multiple>
            <p class="small text-body-secondary">{{transfer.drop}}</p>
            <div id="upload-progress" style="display:none">
              <div class="progress"><div id="progress-bar" class="progress-bar" style="width:0%"></div></div>
              <small>{{transfer.uploading}}</small>
            </div>
          </form>
          <ul id="file-list" class="list-group mt-3 text-start"></ul>
        </div>
      </div>
      <div class="col-md-6">
        <div class="panel h-100">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <h3 class="h6 mb-0">{{transfer.notes}}</h3>
            <button id="btn-copy" class="btn btn-sm btn-outline-secondary"><i class="bi bi-clipboard"></i> {{transfer.copy}}</button>
          </div>
          <textarea id="shared-text" class="form-control" placeholder="{{transfer.placeholder}}"></textarea>
        </div>
      </div>
    </div>

    <div class="text-center mt-4">
      <button id="btn-delete" class="btn btn-outline-danger btn-sm" type="button"><i class="bi bi-trash"></i> {{transfer.delete}}</button>
    </div>

    {{#landing}}
    <div class="text-center mt-4">
      <a href="#how" class="link-quiet">{{hero.ctaSecondary}}</a>
    </div>
    {{/landing}}
  </div>
</section>

{{#landing}}
<section id="how" class="section-block">
  <div class="container">
    <h2 class="section-title text-center">{{how.title}}</h2>
    <div class="row g-4 mt-1">
      <div class="col-md-4 step">
        <span class="step-num d-block">01</span>
        <h3 class="h6">{{how.step1Title}}</h3>
        <p class="text-body-secondary small mb-0">{{how.step1Text}}</p>
      </div>
      <div class="col-md-4 step">
        <span class="step-num d-block">02</span>
        <h3 class="h6">{{how.step2Title}}</h3>
        <p class="text-body-secondary small mb-0">{{how.step2Text}}</p>
      </div>
      <div class="col-md-4 step">
        <span class="step-num d-block">03</span>
        <h3 class="h6">{{how.step3Title}}</h3>
        <p class="text-body-secondary small mb-0">{{how.step3Text}}</p>
      </div>
    </div>

    <div class="instruction-panel mx-auto mt-4">
      <p class="small fw-semibold mb-2 d-none d-md-block">{{how.desktopTitle}}</p>
      <ol class="small text-body-secondary d-none d-md-block ps-3 mb-0">
        <li>{{how.desktopStep1}}</li>
        <li>{{how.desktopStep2}}</li>
        <li>{{how.desktopStep3}}</li>
      </ol>
      <p class="small fw-semibold mb-2 d-md-none">{{how.mobileTitle}}</p>
      <p class="small text-body-secondary d-md-none mb-0">{{how.mobileInstruction}}</p>
    </div>
  </div>
</section>

<section id="usage" class="section-block section-tint">
  <div class="container">
    <h2 class="section-title text-center">{{usage.title}}</h2>
    <div class="row g-4 mt-1">
      <div class="col-sm-6 col-lg-3 use-item">
        <strong>{{usage.card1Title}}</strong>
        <span>{{usage.card1Text}}</span>
      </div>
      <div class="col-sm-6 col-lg-3 use-item">
        <strong>{{usage.card2Title}}</strong>
        <span>{{usage.card2Text}}</span>
      </div>
      <div class="col-sm-6 col-lg-3 use-item">
        <strong>{{usage.card3Title}}</strong>
        <span>{{usage.card3Text}}</span>
      </div>
      <div class="col-sm-6 col-lg-3 use-item">
        <strong>{{usage.card4Title}}</strong>
        <span>{{usage.card4Text}}</span>
      </div>
    </div>
  </div>
</section>

<section id="comparison" class="section-block">
  <div class="container">
    <h2 class="section-title text-center">{{comparison.title}}</h2>
    <p class="section-lead text-center mx-auto">{{comparison.intro}}</p>
    <div class="table-responsive mt-4">
      <table class="table compare-table align-middle">
        <thead>
          <tr>
            <th scope="col">{{comparison.criterion}}</th>
            <th scope="col" class="col-p2l">{{comparison.colP2l}}</th>
            <th scope="col">{{comparison.colAirdrop}}</th>
            <th scope="col">{{comparison.colQuickShare}}</th>
            <th scope="col">{{comparison.colEmail}}</th>
            <th scope="col">{{comparison.colCloud}}</th>
            <th scope="col">{{comparison.colWetransfer}}</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="fw-normal text-body-secondary">{{comparison.rowInstall}}</th>
            <td>{{comparison.p2lInstall}}</td><td>{{comparison.airdropInstall}}</td><td>{{comparison.quickShareInstall}}</td><td>{{comparison.emailInstall}}</td><td>{{comparison.cloudInstall}}</td><td>{{comparison.wetransferInstall}}</td>
          </tr>
          <tr>
            <th scope="row" class="fw-normal text-body-secondary">{{comparison.rowAccount}}</th>
            <td>{{comparison.p2lAccount}}</td><td>{{comparison.airdropAccount}}</td><td>{{comparison.quickShareAccount}}</td><td>{{comparison.emailAccount}}</td><td>{{comparison.cloudAccount}}</td><td>{{comparison.wetransferAccount}}</td>
          </tr>
          <tr>
            <th scope="row" class="fw-normal text-body-secondary">{{comparison.rowCrossPlatform}}</th>
            <td>{{comparison.p2lCrossPlatform}}</td><td>{{comparison.airdropCrossPlatform}}</td><td>{{comparison.quickShareCrossPlatform}}</td><td>{{comparison.emailCrossPlatform}}</td><td>{{comparison.cloudCrossPlatform}}</td><td>{{comparison.wetransferCrossPlatform}}</td>
          </tr>
          <tr>
            <th scope="row" class="fw-normal text-body-secondary">{{comparison.rowStorage}}</th>
            <td>{{comparison.p2lStorage}}</td><td>{{comparison.airdropStorage}}</td><td>{{comparison.quickShareStorage}}</td><td>{{comparison.emailStorage}}</td><td>{{comparison.cloudStorage}}</td><td>{{comparison.wetransferStorage}}</td>
          </tr>
          <tr>
            <th scope="row" class="fw-normal text-body-secondary">{{comparison.rowBidirectional}}</th>
            <td>{{comparison.p2lBidirectional}}</td><td>{{comparison.airdropBidirectional}}</td><td>{{comparison.quickShareBidirectional}}</td><td>{{comparison.emailBidirectional}}</td><td>{{comparison.cloudBidirectional}}</td><td>{{comparison.wetransferBidirectional}}</td>
          </tr>
        </tbody>
      </table>
    </div>
    <p class="small text-body-secondary mt-2 mb-0">{{comparison.note}}</p>
  </div>
</section>

<section id="security" class="section-block section-tint">
  <div class="container">
    <h2 class="section-title text-center">{{security.title}}</h2>
    <p class="section-lead text-center mx-auto">{{security.intro}}</p>
    <div class="sec-list mx-auto mt-4" style="max-width:640px">
      <div>
        <h3 class="h6">{{security.block1Title}}</h3>
        <p class="text-body-secondary small mb-0">{{security.block1Text}}</p>
      </div>
      <div>
        <h3 class="h6">{{security.block2Title}}</h3>
        <p class="text-body-secondary small">{{security.block2Text}}</p>
        <p class="text-body-secondary small mb-0">{{security.block2Detail}}</p>
      </div>
      <div>
        <h3 class="h6">{{security.block3Title}}</h3>
        <p class="text-body-secondary small mb-0">{{security.block3Text}}</p>
      </div>
      <div>
        <h3 class="h6">{{security.block4Title}}</h3>
        <p class="text-body-secondary small">{{security.block4Text}}</p>
        <div class="d-flex gap-3 small">
          <a href="https://github.com/jpdesmontils/phone2laptop" target="_blank" rel="noopener">{{security.linkSource}}</a>
          <a href="https://github.com/jpdesmontils/phone2laptop/issues" target="_blank" rel="noopener">{{security.linkReport}}</a>
        </div>
      </div>
    </div>
    <div class="text-center mt-4">
      <a href="https://github.com/jpdesmontils/phone2laptop" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">{{security.ctaSecondary}}</a>
    </div>
  </div>
</section>

<section id="solenis" class="section-block">
  <div class="container text-center">
    <span class="overline d-block mb-2">{{solenis.overline}}</span>
    <h2 class="section-title">{{solenis.title}}</h2>
    <p class="section-lead mx-auto">{{solenis.text}}</p>
    <div class="d-flex gap-3 justify-content-center mt-3 flex-wrap">
      <a href="https://solenis-studio.fr?utm_source=phone2laptop&amp;utm_medium=product&amp;utm_campaign=product_showcase" target="_blank" rel="noopener" class="btn btn-primary">{{solenis.ctaPrimary}}</a>
      <a href="https://solenis-studio.fr?utm_source=phone2laptop&amp;utm_medium=product&amp;utm_campaign=product_showcase" target="_blank" rel="noopener" class="link-quiet align-self-center">{{solenis.ctaSecondary}}</a>
    </div>
  </div>
</section>

<section id="support" class="section-block">
  <div class="container">
    <div class="support-row">
      <div>
        <h2 class="section-title mb-1" style="text-align:left">{{support.title}}</h2>
        <p class="text-body-secondary small mb-0">{{support.text}}</p>
      </div>
      <a href="https://donate.stripe.com/4gM5kE2z69M21qFbDAew807" target="_blank" rel="noopener" class="btn btn-outline-success">{{support.cta}}</a>
    </div>
  </div>
</section>
{{/landing}}

</main>

<div class="modal fade" id="preview-modal" tabindex="-1" aria-labelledby="preview-modal-title" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="preview-modal-title"></h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{transfer.cancel}}"></button>
      </div>
      <div class="modal-body p-0" id="preview-modal-body"></div>
    </div>
  </div>
</div>

<div class="modal fade" id="delete-modal" tabindex="-1" aria-labelledby="delete-modal-title" aria-describedby="delete-modal-message" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h2 class="modal-title fs-5" id="delete-modal-title">{{transfer.deleteModalTitle}}</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{transfer.cancel}}"></button>
      </div>
      <div class="modal-body" id="delete-modal-message"></div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{transfer.cancel}}</button>
        <button type="button" class="btn btn-danger" id="delete-modal-confirm">{{transfer.confirmDelete}}</button>
      </div>
    </div>
  </div>
</div>

<footer class="site-footer">
  <div class="container">
    <div class="d-flex flex-wrap gap-4 justify-content-center small mb-3">
      {{#landing}}
      <a href="#how">{{footer.how}}</a>
      <a href="#security">{{footer.security}}</a>
      {{/landing}}
      <a href="https://github.com/jpdesmontils/phone2laptop" target="_blank" rel="noopener">{{footer.source}}</a>
      <a href="https://github.com/jpdesmontils/phone2laptop/issues" target="_blank" rel="noopener">{{footer.report}}</a>
      <a href="https://donate.stripe.com/4gM5kE2z69M21qFbDAew807" target="_blank" rel="noopener">{{footer.support}}</a>
    </div>
    <div class="text-center small text-body-secondary">
      <div>phone2laptop — {{footer.tagline}}</div>
      <div>{{footer.madeBy}} <a href="https://solenis-studio.fr" target="_blank" rel="noopener">Solenis Studio</a> · © {{year}}</div>
    </div>
  </div>
</footer>

<script>window.P2L={{{p2l_config}}};document.getElementById('language-select').addEventListener('change',function(){location.href=this.dataset[this.value+'Url']+location.hash;});</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="{{base_url}}/js/sync.js?v={{sync_js_version}}"></script>
</body>
</html>
